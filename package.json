{
  "name": "harness-scan",
  "version": "0.1.0",
  "description": "Lighthouse for your coding agent — scans local Claude Code session history for recurring failures.",
  "type": "module",
  "bin": {
    "harness-scan": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "claude-code",
    "ai-agent",
    "developer-tools",
    "harness-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VittorioC13/harnessc.git"
  },
  "homepage": "https://github.com/VittorioC13/harnessc#readme",
  "bugs": {
    "url": "https://github.com/VittorioC13/harnessc/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "demo:fix-preview": "eslint --config examples/fix-preview/eslint.config.js examples/fix-preview/bad-example.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
